---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import EntryCard from '../../components/EntryCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const talks = (await getCollection('talks', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Talks · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: var(--content-width);
			}
			ul {
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Talks</h1>
			<ul>
				{
					talks.map((talk) => {
						const metaParts = [`📚 ${talk.data.venue}`];
						if (talk.data.location) metaParts.push(`🌍 ${talk.data.location}`);
						if (talk.data.link) metaParts.push(`🎥 <a href="${talk.data.link}">Watch</a>`);
						return (
							<li id={talk.id}>
								<EntryCard
									title={talk.data.title}
									heroImage={talk.data.heroImage}
									meta={metaParts.join(' · ')}
									authors={talk.data.description ?? ''}
								/>
							</li>
						);
					})
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
