---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import About from "../components/About.astro";
import News from "../components/News.astro";
import EntryCard from "../components/EntryCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TeachingTable from "../components/TeachingTable.astro";
import AdvisingTable from "../components/AdvisingTable.astro";
import { SITE_AUTHOR_NAME, SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { teaching } from "../data/teaching";
import { advising } from "../data/advising";
import { formatAuthors, formatVenue, publicationBadge } from "../lib/formatUtils";

import { getCollection } from "astro:content";

const news = (await getCollection("news")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const publications = (await getCollection("publications", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.year - a.data.year,
);

const talks = (await getCollection("talks", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<About />

			<section class="section">
				<SectionHeading number={1}>📰 News</SectionHeading>
				<div class="news-list">
					{
						news.map((item) => (
							<News
								date={item.data.date.toLocaleDateString("en-US", {
									month: "short",
									year: "numeric",
								})}
								text={item.data.text}
								link={item.data.link}
							/>
						))
					}
				</div>
			</section>

			<section class="section">
				<SectionHeading number={2}>📊 Research</SectionHeading>
				<p class="section-lead">
					A selection of my publications. For a full, up-to-date list, see the <a
						href="/publications">publications page</a
					> or <a href="https://scholar.google.com/citations?user=C84lnbUAAAAJ"
						>Google Scholar</a
					>.
				</p>

				<ul class="entry-list">
					{
						publications.slice(0, 5).map((pub) => (
							<li>
								<EntryCard
									title={pub.data.title}
									heroImage={pub.data.heroImage}
									badge={publicationBadge(pub.data.type)}
									meta={formatVenue(pub.data.venue, pub.data.type, pub.data.location)}
									authors={formatAuthors(pub.data.authors.map((a) => a.name), SITE_AUTHOR_NAME)}
									awards={pub.data.awards}
								/>
							</li>
						))
					}
				</ul>
			</section>

			<section class="section">
				<SectionHeading number={3}>🗣️ Talks</SectionHeading>
				<p class="section-lead">
					Invited talks and podcast appearances. See also the full <a href="/talks"
						>talks page</a
					>.
				</p>
				<ul class="entry-list">
					{
						talks.map((talk) => {
							const metaParts = [`📚 ${talk.data.venue}`];
							if (talk.data.location) metaParts.push(`🌍 ${talk.data.location}`);
							if (talk.data.link) metaParts.push(`🎥 <a href="${talk.data.link}">Watch</a>`);
							return (
								<li>
									<EntryCard
										title={talk.data.title}
										heroImage={talk.data.heroImage}
										meta={metaParts.join(" · ")}
										authors={talk.data.description ?? ""}
										compact
									/>
								</li>
							);
						})
					}
				</ul>
			</section>

			<section class="section">
				<SectionHeading number={4}>📝 Teaching</SectionHeading>
				<p class="section-lead">
					Courses I have taught as a Teaching Assistant as part of my Ph.D.
					programme, supervised by Prof. Luis M. Bergasa.
				</p>
				<TeachingTable rows={teaching} />
			</section>

			<section class="section">
				<SectionHeading number={5}>🎓 Advising</SectionHeading>
				<p class="section-lead">
					Academic works I have co-supervised jointly with Prof. Luis M. Bergasa,
					guiding the students through their research projects.
				</p>
				<AdvisingTable rows={advising} />
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.section {
		margin-top: 4rem;
	}

	.section-lead {
		color: var(--text-secondary);
		font-size: 0.95em;
		max-width: 68ch;
		margin: 0 0 1.25rem 0;
	}

	.news-list {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.entry-list {
		list-style-type: none;
		margin: 0;
		padding: 0;
	}

	@media (max-width: 720px) {
		.section {
			margin-top: 3rem;
		}
	}
</style>
