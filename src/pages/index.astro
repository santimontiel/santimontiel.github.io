---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import About from "../components/About.astro";
import News from "../components/News.astro";
import EntryCard from "../components/EntryCard.astro";
import TeachingTable from "../components/TeachingTable.astro";
import AdvisingTable from "../components/AdvisingTable.astro";
import { SITE_AUTHOR_NAME, SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { teaching } from "../data/teaching";
import { advising } from "../data/advising";
import { formatAuthors, formatVenue, publicationBadge } from "../lib/formatUtils";

import profilePic from "../assets/santi_photo.jpg";
import { getCollection } from "astro:content";

const news = (await getCollection("news")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const publications = (await getCollection("publications", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.year - a.data.year,
);

const talks = (await getCollection("talks", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hello, there! I'm Santi Montiel 🧙🏻‍♂️</h1>
			<About image={profilePic} />
			<style>
				ul {
					list-style-type: none;
					margin: 0;
					padding: 0;
				}
			</style>

			<h2>📰 News</h2>
			{
				news.map((item) => (
					<News
						date={item.data.date.toLocaleDateString("en-US", { month: "short", year: "numeric" })}
						text={item.data.text}
						link={item.data.link}
					/>
				))
			}
			<br />

			<section>
				<h2>📊 Research</h2>
				<p>
					Here is a selection of my publications. For a full list, please
					check <a
						href="https://scholar.google.com/citations?user=C84lnbUAAAAJ"
						>Google Scholar</a
					>. See also the full <a href="/publications">publications page</a>.
				</p>

				<ul>
					{
						publications.slice(0, 5).map((pub) => (
							<li>
								<EntryCard
									title={pub.data.title}
									heroImage={pub.data.heroImage}
									badge={publicationBadge(pub.data.type)}
									meta={formatVenue(pub.data.venue, pub.data.type, pub.data.location)}
									authors={formatAuthors(pub.data.authors.map((a) => a.name), SITE_AUTHOR_NAME)}
								/>
							</li>
						))
					}
				</ul>
			</section>

			<h2>🗣️ Talks</h2>
			<p>
				See also the full <a href="/talks">talks page</a>.
			</p>
			<ul>
				{
					talks.map((talk) => {
						const metaParts = [`📚 ${talk.data.venue}`];
						if (talk.data.location) metaParts.push(`🌍 ${talk.data.location}`);
						if (talk.data.link) metaParts.push(`🎥 <a href="${talk.data.link}">Watch</a>`);
						return (
							<li>
								<EntryCard
									title={talk.data.title}
									heroImage={talk.data.heroImage}
									meta={metaParts.join(" · ")}
									authors={talk.data.description ?? ""}
									compact
								/>
							</li>
						);
					})
				}
			</ul>

			<h2>📝 Teaching</h2>
			<p>
				I have taught the following courses as part of the curriculum of
				my Ph.D. program as Teaching Assistant, supervised by Prof. Luis
				M. Bergasa.
			</p>
			<TeachingTable rows={teaching} />

			<p>
				I have acted as co-supervisor of the following academic works
				jointly with Prof. Luis M. Bergasa, guiding the students in
				their research projects:
			</p>
			<AdvisingTable rows={advising} />
		</main>
		<Footer />
	</body>
</html>
