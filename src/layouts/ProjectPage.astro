---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import LinkButtons from "../components/LinkButtons.astro";

type Props = CollectionEntry<"projects">["data"];

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	authors,
	affiliations,
	links,
	announcement,
} = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{
					heroImage && (
						<div class="project-hero-image">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</div>
					)
				}
				<div class="project-prose">
					<div class="project-title">
						<h1>{title}</h1>
					</div>

					<div class="project-date">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<div class="last-updated-on">
									Last updated on <FormattedDate date={updatedDate} />
								</div>
							)
						}
					</div>

					<p class="project-authors">
						{
							authors.map((author, i) => (
								<>
									{author.url ? <a href={author.url}>{author.name}</a> : author.name}
									{author.affiliation && <sup>{author.affiliation}</sup>}
									{i < authors.length - 1 &&
										(i === authors.length - 2 ? (authors.length > 2 ? ', and ' : ' and ') : ', ')}
								</>
							))
						}
					</p>

					{
						affiliations.length > 0 && (
							<div class="project-logo-row">
								{affiliations.map((affiliation, i) => (
									<div class="project-logo-item">
										<sup>{i + 1}</sup>
										{affiliation.url ? (
											<a href={affiliation.url}>
												<Image src={affiliation.logo} alt={affiliation.name} />
											</a>
										) : (
											<Image src={affiliation.logo} alt={affiliation.name} />
										)}
									</div>
								))}
							</div>
						)
					}

					{
						links && (
							<div class="project-info">
								<LinkButtons links={links} />
							</div>
						)
					}

					{
						announcement && (
							<div class="project-announcement">
								<h5>{announcement}</h5>
							</div>
						)
					}
				</div>

				<div class="project-body">
					<slot />
				</div>
			</article>
		</main>

		<Footer />
	</body>
</html>
