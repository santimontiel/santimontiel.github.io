---
// EntryCard.astro
// A single "media card" (thumbnail + meta line + title + subtext) used for
// publications and talks alike — previously duplicated as separate
// Publication.astro / Talk.astro components with near-identical markup/CSS.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	heroImage?: ImageMetadata;
	badge?: { text: string; type: string };
	// Pre-formatted HTML (may contain <br/>, <a>, emoji, etc.)
	meta: string;
	authors: string;
	// Shorter thumbnail + tighter spacing, for denser listings (e.g. Talks).
	compact?: boolean;
}

const { title, heroImage, badge, meta, authors, compact = false } = Astro.props;
const imageHeight = compact ? 110 : 160;
---

<article class:list={['entry-card', { 'entry-card--compact': compact }]}>
	{
		heroImage && (
			<div class="entry-image">
				<Image src={heroImage} alt={title} width={240} height={imageHeight} />
			</div>
		)
	}
	<div class="entry-content">
		<div class="entry-meta">
			{badge && <span class={`entry-badge entry-badge--${badge.type}`}>{badge.text}</span>}
			<span class="entry-venue" set:html={meta} />
		</div>
		<h3 class="entry-title">{title}</h3>
		<p class="entry-authors" set:html={authors} />
	</div>
</article>

<style>
	.entry-card {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		margin-bottom: 1rem;
		padding: 1rem;
		border-radius: var(--radius-lg);
		transition: background-color 0.15s ease, box-shadow 0.15s ease;
	}

	.entry-card:hover {
		background: var(--bg-surface);
		box-shadow: var(--shadow-sm);
	}

	.entry-image img {
		width: 240px;
		height: 160px;
		object-fit: cover;
		border-radius: var(--radius-lg);
	}

	.entry-card--compact {
		padding: 0.65rem 1rem;
		margin-bottom: 0.4rem;
	}

	.entry-card--compact .entry-image img {
		height: 110px;
	}

	.entry-content {
		flex: 1;
	}

	.entry-meta {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		margin-bottom: 0.3rem;
	}

	.entry-badge {
		font-size: 0.8rem;
		font-weight: 600;
		border-radius: var(--radius-sm);
		padding: 0.25rem 0.4rem;
		text-align: center;
		flex-shrink: 0;
		min-width: 85px;
	}

	.entry-badge--preprint {
		background: var(--badge-preprint-bg);
		color: var(--badge-preprint-text);
	}
	.entry-badge--conference {
		background: var(--badge-conference-bg);
		color: var(--badge-conference-text);
	}
	.entry-badge--journal {
		background: var(--badge-journal-bg);
		color: var(--badge-journal-text);
	}
	.entry-badge--workshop {
		background: var(--badge-workshop-bg);
		color: var(--badge-workshop-text);
	}
	.entry-badge--fallback {
		background: var(--badge-fallback-bg);
		color: var(--badge-fallback-text);
	}

	.entry-venue {
		font-size: 0.85rem;
		color: var(--text-tertiary);
		line-height: 1.3;
	}

	.entry-title {
		margin: 0.2rem 0;
		font-size: 1.1rem;
	}

	.entry-authors {
		font-size: 0.9rem;
		margin: 0;
		color: var(--text-secondary);
	}

	@media (max-width: 640px) {
		.entry-card {
			flex-direction: column;
			gap: 0.75rem;
		}

		.entry-image {
			width: 100%;
			display: flex;
			justify-content: center;
		}

		.entry-image img {
			width: 100%;
			max-width: 240px;
			height: auto;
		}
	}
</style>
