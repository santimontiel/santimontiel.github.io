---
// EntryCard.astro
// A single "media card" (thumbnail + meta line + title + subtext) used for
// publications and talks alike — previously duplicated as separate
// Publication.astro / Talk.astro components with near-identical markup/CSS.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	heroImage?: ImageMetadata;
	badge?: { text: string; color: string };
	// Pre-formatted HTML (may contain <br/>, <a>, emoji, etc.)
	meta: string;
	authors: string;
}

const { title, heroImage, badge, meta, authors } = Astro.props;
---

<article class="entry-card">
	{
		heroImage && (
			<div class="entry-image">
				<Image src={heroImage} alt={title} width={240} height={160} />
			</div>
		)
	}
	<div class="entry-content">
		<div class="entry-meta">
			{badge && <span class="entry-badge" style={`background-color: ${badge.color};`}>{badge.text}</span>}
			<span class="entry-venue" set:html={meta} />
		</div>
		<h3 class="entry-title">{title}</h3>
		<p class="entry-authors" set:html={authors} />
	</div>
</article>

<style>
	.entry-card {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.entry-image img {
		width: 240px;
		height: 160px;
		object-fit: cover;
		border-radius: 8px;
	}

	.entry-content {
		flex: 1;
	}

	.entry-meta {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		margin-bottom: 0.3rem;
	}

	.entry-badge {
		font-size: 0.8rem;
		color: #fff;
		font-weight: 600;
		border-radius: 6px;
		padding: 0.25rem 0.4rem;
		text-align: center;
		flex-shrink: 0;
		min-width: 85px;
	}

	.entry-venue {
		font-size: 0.85rem;
		color: #888;
		line-height: 1.3;
	}

	.entry-title {
		margin: 0.2rem 0;
		font-size: 1.1rem;
	}

	.entry-authors {
		font-size: 0.9rem;
		margin: 0;
		color: #444;
	}

	@media (max-width: 640px) {
		.entry-card {
			flex-direction: column;
			gap: 0.75rem;
		}

		.entry-image {
			width: 100%;
			display: flex;
			justify-content: center;
		}

		.entry-image img {
			width: 100%;
			max-width: 240px;
			height: auto;
		}
	}
</style>
