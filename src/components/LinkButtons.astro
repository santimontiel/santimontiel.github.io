---
// LinkButtons.astro
// Renders one Button per populated key in `links`, with a fixed
// emoji/color per link type so authoring a new project/publication never
// needs to pick styling — just supply the URL.
import Button from './Button.astro';

interface Props {
	links?: {
		paper?: string;
		code?: string;
		weights?: string;
		video?: string;
		demo?: string;
		poster?: string;
		slides?: string;
	};
}

const { links } = Astro.props;

const STYLE: Record<string, { text: string; emoji: string }> = {
	paper: { text: 'arXiv', emoji: '📄' },
	code: { text: 'Code', emoji: '🖥️' },
	weights: { text: 'Weights', emoji: '🤗' },
	video: { text: 'Video', emoji: '🎥' },
	demo: { text: 'Demo', emoji: '🚀' },
	poster: { text: 'Poster', emoji: '🖼️' },
	slides: { text: 'Slides', emoji: '📊' },
};

const entries = Object.entries(links ?? {}).filter((entry): entry is [string, string] => Boolean(entry[1]));
---

{
	entries.map(([key, href]) => {
		const style = STYLE[key];
		return style ? <Button href={href} text={style.text} emoji={style.emoji} /> : null;
	})
}
