---
// LinkButtons.astro
// Renders one Button per populated key in `links`, with a fixed
// emoji/color per link type so authoring a new project/publication never
// needs to pick styling — just supply the URL.
import Button from './Button.astro';

interface Props {
	links?: {
		paper?: string;
		code?: string;
		weights?: string;
		video?: string;
		demo?: string;
		poster?: string;
		slides?: string;
	};
}

const { links } = Astro.props;

const STYLE: Record<string, { text: string; emoji: string; backgroundColor: string }> = {
	paper: { text: 'arXiv', emoji: '📄', backgroundColor: 'rgba(179, 27, 27, 0.8)' },
	code: { text: 'Code', emoji: '🖥️', backgroundColor: 'rgba(35, 41, 37, 0.8)' },
	weights: { text: 'Weights', emoji: '🤗', backgroundColor: 'rgba(255, 100, 0, 0.8)' },
	video: { text: 'Video', emoji: '🎥', backgroundColor: 'rgba(30, 90, 180, 0.8)' },
	demo: { text: 'Demo', emoji: '🚀', backgroundColor: 'rgba(120, 50, 180, 0.8)' },
	poster: { text: 'Poster', emoji: '🖼️', backgroundColor: 'rgba(20, 120, 110, 0.8)' },
	slides: { text: 'Slides', emoji: '📊', backgroundColor: 'rgba(90, 90, 90, 0.8)' },
};

const entries = Object.entries(links ?? {}).filter((entry): entry is [string, string] => Boolean(entry[1]));
---

{
	entries.map(([key, href]) => {
		const style = STYLE[key];
		return style ? (
			<Button href={href} text={style.text} emoji={style.emoji} backgroundColor={style.backgroundColor} />
		) : null;
	})
}
