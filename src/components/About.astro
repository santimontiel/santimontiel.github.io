---
import PhotoCarousel from './PhotoCarousel.astro';
import { heroGallery } from '../data/gallery';
---

<article class="about-section">
    <div class="about-hero">
        <PhotoCarousel photos={heroGallery} />
        <div class="about-intro">
            <h1 class="about-name">Santi Montiel <span class="about-wizard" role="img" aria-label="wizard">🧙🏻‍♂️</span></h1>
            <p class="about-role">
                Ph.D. Student in Camera&ndash;RADAR Fusion for Autonomous Driving
                <span class="about-affiliation">RobeSafe Research Group &middot; University of Alcalá</span>
            </p>
        </div>
    </div>

    <div class="about-content">
        <p class="about-description">
            I'm <b>Santi Montiel</b>, a PhD student at the University of Alcalá,
            Madrid, Spain. Currently focused on crafting Camera-RADAR fusion
            Deep Learning models as part of my research.
            <br /><br />

            With a former background in Industrial Engineering and Robotics, I
            decided to pursue a PhD in the intersection of Autonomous Driving
            and Deep Learning, entitled <b
                >Deep Learning based on Camera-RADAR Fusion for Perception in
                Autonomous Driving</b
            >, under the supervision of <a
                href="http://www.robesafe.uah.es/personal/bergasa/"
                >Prof. Luis M. Bergasa</a
            > and <a href="https://allamazares.jimdofree.com/"
                >Dr. Ángel Llamazares</a
            >, at the <b>RobeSafe Research Group</b> of <a href="https://www.uah.es/"
                ><b>University of Alcalá</b></a
            >. I carried out a research internship at the <b
                >Intelligent Vehicles Lab</b
            > of <a href="https://www.tudelft.nl/en/"
                ><b>Delft University of Technology</b></a
            >, under the supervision of <a
                href="https://sites.google.com/it-caesar.de/homepage/"
                >Dr. Holger Caesar</a
            >.
        </p>

        <p class="about-more-label">Some more about me:</p>
        <ul class="about-bullets">
            <li class="about-bullet">
                <span class="about-bullet-icon">🤖</span>
                <span>Former team member of UAH Robotics Team, speaker at ROSCon Spain.</span>
            </li>
            <li class="about-bullet">
                <span class="about-bullet-icon">🤝</span>
                <span>Always open to research collaborations! Feel free to get in touch
                with ideas.</span>
            </li>
            <li class="about-bullet">
                <span class="about-bullet-icon">🎾</span>
                <span>Outside research and coding, I enjoy video games, running, and
                pádel.</span>
            </li>
        </ul>

        <p class="about-contact">
            <span class="about-bullet-icon">📩</span>
            <span>Contact: <a href="mailto:santiago.montiel@uah.es"
                >santiago.montiel@uah.es</a
            ></span>
        </p>
    </div>
</article>

<style>
    .about-section {
        margin-bottom: 1rem;
    }

    /* Carousel on the left, name + role on the right; the bio below runs
       the full column width. */
    .about-hero {
        display: flex;
        align-items: center;
        gap: 2.25rem;
        margin-bottom: 2rem;
    }

    .about-intro {
        flex: 1;
        min-width: 0;
        /* Name and role sit flush against the right edge of the column,
           with the carousel anchoring the left. */
        text-align: right;
    }

    .about-content {
        min-width: 0;
    }

    .about-name {
        margin: 0;
        font-size: clamp(2rem, 1.5rem + 2vw, 2.6rem);
        letter-spacing: -0.02em;
        line-height: 1.1;
    }

    /* Slightly smaller than the name so the glyph sits on the cap height
       rather than towering over it. */
    .about-wizard {
        font-size: 0.8em;
        white-space: nowrap;
    }

    /* Role + affiliation strapline, directly under the name. */
    .about-role {
        margin: 0.6rem 0 0 0;
        color: var(--text-secondary);
        font-family: 'Space Grotesk', 'Inter', ui-sans-serif, system-ui, sans-serif;
        font-size: 1rem;
        line-height: 1.45;
    }

    .about-affiliation {
        display: block;
        color: var(--text-tertiary);
        font-size: 0.9rem;
    }

    .about-description {
        margin: 0;
        color: var(--text-secondary);
    }

    .about-description b {
        font-family: 'Space Grotesk', 'Inter', ui-sans-serif, system-ui, sans-serif;
        color: var(--text-primary);
    }

    .about-description a b {
        color: inherit;
    }

    .about-more-label {
        margin: 1.4em 0 0.6em 0;
        color: var(--text-secondary);
    }

    .about-bullets {
        list-style-type: none;
        padding: 0;
        margin: 0 0 1em 0;
        display: flex;
        flex-direction: column;
        gap: 0.5em;
    }

    .about-bullet {
        display: flex;
        align-items: flex-start;
        gap: 0.75em;
        color: var(--text-secondary);
    }

    .about-bullet-icon {
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.9em;
        height: 1.9em;
        border-radius: var(--radius-full);
        background: var(--bg-surface-sunken);
    }

    .about-contact {
        display: flex;
        align-items: center;
        gap: 0.75em;
        margin: 0;
        color: var(--text-secondary);
    }

    /* Responsive design */
    @media (max-width: 640px) {
        .about-hero {
            flex-direction: column;
            align-items: flex-start;
            gap: 1.5rem;
            margin-bottom: 1.75rem;
        }

        /* Stacked, there is no photo to balance against, so go back to
           reading left-to-right. */
        .about-intro {
            text-align: left;
        }
    }
</style>
