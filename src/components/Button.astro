---
// Button.astro
interface Props {
  href: string;
  text?: string;
  emoji?: string;
  class?: string;
}

const {
  href,
  text = "Button",
  emoji = "📄",
  class: className = "",
} = Astro.props;
---

<a href={href} class={`button icon ${className}`}>
  {text} <span class="emoji">{emoji}</span>
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    background: var(--bg-surface-sunken);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    font-weight: 600;
  }

  .button:hover {
    background: var(--accent-muted);
    border-color: var(--accent);
    color: var(--accent);
  }

  .emoji {
    font-style: normal;
  }

</style>