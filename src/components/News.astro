---
// NewsItem.astro
export interface Props {
  date: string;
  text: string;
  link?: string;
}

const { date, text, link } = Astro.props;
---

<div class="news-item">
  <div class="news-date">
    {date}
  </div>
  <div class="news-text">
    {text} {link && <a href={link}>Read more</a>}
  </div>
</div>

<style>
  .news-item {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 0.2rem 0;
  }

  /* Fixed-width, tabular date chip so every row's text starts on the
     same optical column regardless of the month's name length. */
  .news-date {
    flex: 0 0 5.5rem;
    font-weight: 600;
    color: var(--accent);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    background-color: var(--accent-muted);
    border-radius: var(--radius-full);
    padding: 0.3rem 0.5rem;
    text-align: center;
    height: fit-content;
    margin-top: 0.15rem;
  }

  .news-text {
    font-size: 1rem;
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .news-item {
      flex-direction: column;
      gap: 0.5rem;
    }
    
    .news-date {
      flex: none;
      align-self: flex-start;
      width: fit-content;
    }
  }
</style>